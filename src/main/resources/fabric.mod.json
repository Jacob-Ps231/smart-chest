{
	"schemaVersion": 1,
	"id": "smartchest",
	"version": "${version}",
	"name": "Smart Chest",
	"description": "A chest with upgrade slots: higher stack capacity and automatic compression into blocks. Copper golems can use it.",
	"authors": [
		"Jerome"
	],
	"contact": {
		"homepage": "https://github.com/Jacob-Ps231/smartchest",
		"sources": "https://github.com/Jacob-Ps231/smartchest",
		"issues": "https://github.com/Jacob-Ps231/smartchest/issues"
	},
	"license": "MIT",
	"icon": "assets/smartchest/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"re.jerome.smartchest.SmartChestMod"
		],
		"client": [
			"re.jerome.smartchest.client.SmartChestClient"
		]
	},
	"accessWidener": "smartchest.accesswidener",
	"mixins": [
		"smartchest.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
